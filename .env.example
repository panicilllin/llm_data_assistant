# Copy to .env and fill in. .env is git-ignored.

# Any pydantic-ai model string:
#   deepseek:deepseek-chat | openai:gpt-4.1-mini | anthropic:claude-sonnet-5-5
LLM_MODEL=deepseek:deepseek-chat

# Key for the provider chosen above (only one is needed).
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

PYDANTIC_AI_NO_BANNER=1
